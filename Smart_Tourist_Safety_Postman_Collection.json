					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/safety-zones/check?latitude=11.0168&longitude=76.9558",
							"host": ["{{baseUrl}}"],
							"path": ["api", "safety-zones", "check"],
