							"raw": "{\n  \"zoneName\": \"High Alpine Ridge Zone C\",\n  \"description\": \"High altitude ridge subject to severe snow squalls\",\n  \"latitude\": 11.0500,\n  \"longitude\": 76.9800,\n  \"radius\": 4.0,\n  \"dangerLevel\": \"HIGH\",\n  \"warningMessage\": \"ALERT: High wind and frostbite risk!\",\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/safety-zones",
							"host": ["{{baseUrl}}"],
							"path": ["api", "safety-zones"]
